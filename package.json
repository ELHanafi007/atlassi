{
  "name": "atlassi",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "build": "npm run build --prefix client",
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
    "vercel-build": "npx prisma generate --schema=server/prisma/schema.prisma && npm run build --prefix client",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "start": "node server/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ELHanafi007/atlassi.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ELHanafi007/atlassi/issues"
  },
  "homepage": "https://github.com/ELHanafi007/atlassi#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "7.7.0",
    "@vercel/blob": "^0.27.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "prisma": "7.7.0"
  }
}
