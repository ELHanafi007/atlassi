# ==============================================================
# ATLASSI ENVIRONMENT CONFIGURATION
# ==============================================================

# Database: PostgreSQL connection string (Neon, Supabase, Vercel Postgres)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Environment mode: development or production
NODE_ENV=production

# Server Port (used for local server only, Vercel manages port automatically)
PORT=5000

# Client URL (for CORS whitelist if running separate domains)
# Example: https://atlassi.vercel.app
CLIENT_URL=

# Test OTP code (optional override for phone verification in non-production)
TEST_OTP_CODE=123456
